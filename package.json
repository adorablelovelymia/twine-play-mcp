{
  "name": "twine-play-mcp",
  "version": "0.1.2",
  "description": "MCP server that lets AI agents play, test and QA Twine / interactive-fiction HTML games.",
  "type": "module",
  "license": "MIT",
  "author": "adorablelovelymia <selinawell116@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adorablelovelymia/twine-play-mcp.git"
  },
  "homepage": "https://github.com/adorablelovelymia/twine-play-mcp#readme",
  "bugs": {
    "url": "https://github.com/adorablelovelymia/twine-play-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "twine",
    "interactive-fiction",
    "sugarcube",
    "harlowe",
    "chapbook",
    "snowman",
    "playwright",
    "game-testing",
    "qa",
    "ai-agent"
  ],
  "bin": {
    "twine-play-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README-zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/bridge && cp src/bridge/bridge.js dist/bridge/bridge.js",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "spike": "tsx scripts/spike.ts",
    "clarity": "tsx scripts/clarity-check.ts",
    "formats": "tsx scripts/formats.ts",
    "fixtures": "bash test/fixtures/build.sh",
    "smoke": "tsx scripts/mcp-smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
